# ─── TravelSuperApp — environment template ──────────────────────────────
#
# Copy this file to `.env.local` and fill in the blanks.
# `.env.local` is gitignored; never commit real credentials.
#
# Values annotated (dev) match the local Docker Compose stack in
# `infra/docker-compose.yml` — keep them in sync when you change those.
# Values annotated (secret) must be generated per-environment and come
# from Doppler in staging/production. The literal `REPLACE_ME_SEE_DOPPLER`
# is a deliberate sentinel: any runtime service that boots with it still
# in place will fail env validation at start (`@app/config`).
#
# Optional blocks are commented out by default so a fresh checkout
# boots with the minimum viable set.
#
# Validated by `@app/config/src/schema.ts` ([III.11.1]).
# Installed by prompt [IX.32.4]. See docs/env.md for field-level notes.

# ─── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database (Postgres 16 + PostGIS + pgvector) ────────────────────────
# (dev) matches infra/docker-compose.yml postgres service.
# In staging / prod DATABASE_URL goes through PgBouncer (:6543 +
# ?pgbouncer=true&connection_limit=1) and DIRECT_URL stays on :5432
# for `prisma migrate`. See docs/runbooks/database-pooling.md ([Q1]).
DATABASE_URL=postgresql://travel:travel_dev@localhost:5432/travel_dev
DIRECT_URL=postgresql://travel:travel_dev@localhost:5432/travel_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis 7 ────────────────────────────────────────────────────────────
# (dev) password=redis_dev from docker-compose.
REDIS_URL=redis://:redis_dev@localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────
# Must be ≥ 32 chars each. (secret) rotate per environment.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_ME_SEE_DOPPLER_min_32_chars_long_AAAAAAA
JWT_REFRESH_SECRET=REPLACE_ME_SEE_DOPPLER_min_32_chars_long_BBBBBBB
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── OAuth (optional — uncomment + fill to enable) ──────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ─── AI / LLM (POST.4 — 4-tier fallback chain, all optional) ────────────
# Provider priority at boot: Anthropic → Gemini → Ollama → built-in stub.
# Setting any of the three keys/URLs activates that tier; leave them all
# blank for the deterministic stub (works offline, no setup).
#
# Anthropic Claude — paid, premium quality. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-opus-4-7
#
# Google Gemini — free tier (1500 req/day, no card). Key from aistudio.google.com.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash
#
# Ollama — local LLM, truly $0. Install from ollama.com, then:
#   ollama pull llama3.1:8b && ollama serve
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
#
# OPENAI_API_KEY=
AI_SERVICE_URL=http://localhost:8001

# ─── Stripe (POST.9 — Premium subs; optional, 503s when blank) ──────────
# TEST mode is FREE forever — get keys at dashboard.stripe.com (no card).
# Local webhook setup: `stripe listen --forward-to http://localhost:3000/api/v1/payments/webhook`
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# STRIPE_PRICE_PREMIUM=price_xxxxx          (recurring $9/mo USD)
# STRIPE_CONNECT_CLIENT_ID=                 (reserved for future agent escrow flows)

# ─── External APIs (optional) ───────────────────────────────────────────
# GOOGLE_PLACES_API_KEY=
# FOURSQUARE_API_KEY=
# MAPBOX_ACCESS_TOKEN=
# Live navigation: OSRM has a safe public default (leave commented to
# use it; a blank value FAILS the url() check). TomTom is optional —
# absent → deterministic mock traffic, present → live traffic flow.
# OSRM_BASE_URL=https://router.project-osrm.org
# TOMTOM_API_KEY=

# ─── S3-compatible storage ──────────────────────────────────────────────
# (dev) matches the MinIO service in docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=travel-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
S3_REGION=us-east-1

# ─── Comms (optional) ───────────────────────────────────────────────────
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ─── Meilisearch ────────────────────────────────────────────────────────
# (dev) matches the meilisearch service in docker-compose.
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=meili_dev_key_change_me_minimum_16_chars

# ─── Observability (POST.10 — Sentry + Honeycomb, all optional) ─────────
# Both have FREE tiers with no card required.
# SENTRY_DSN_API=https://xxx@o000000.ingest.sentry.io/0000000
# SENTRY_DSN_WEB=https://yyy@o000000.ingest.sentry.io/0000001
# NEXT_PUBLIC_SENTRY_DSN_WEB=https://yyy@o000000.ingest.sentry.io/0000001
# HONEYCOMB_API_KEY=hcaik_xxxxx
# HONEYCOMB_DATASET=api-development
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   (Jaeger fallback)
# POSTHOG_API_KEY=

# ─── Feature flags ──────────────────────────────────────────────────────
FEATURE_3D_ENABLED=false
FEATURE_SATELLITE_CROWD=false

# ─── Security ───────────────────────────────────────────────────────────
# Must be ≥ 32 chars. (secret) — peppers rate-limit keys in Redis.
# Generate with: openssl rand -hex 32
RATE_LIMIT_PEPPER=REPLACE_ME_SEE_DOPPLER_min_32_chars_long_CCCCCCC

# Shared pepper for email / IP hashes (Playbook §13.11, §13.4). ≥ 32 chars.
# Rotating this invalidates all email-hash uniqueness lookups — plan a
# dual-write migration when rotating.
EMAIL_PEPPER=REPLACE_ME_SEE_DOPPLER_min_32_chars_long_DDDDDDDD

# Pepper for sha256-hashed MFA backup codes. ≥ 32 chars. Rotating
# this invalidates every outstanding backup code — plan a re-
# generation flow before rotating.
BACKUP_CODE_PEPPER=REPLACE_ME_SEE_DOPPLER_min_32_chars_long_EEEEEEEE

# CORS allow-list: comma-separated exact origins (scheme+host+port).
# Empty means "no cross-origin requests" (safe default). Staging/prod get
# their allow-list from Doppler. [IV.18.1.17]
# Dev suggestion (uncomment when running web + mobile-web against the api):
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=
