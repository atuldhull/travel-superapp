{
  "name": "travel-superapp",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile-first, AI-powered travel super-app. See travel-app-playbook.md for architecture.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:up": "bash scripts/dev-bootstrap.sh",
    "dev:up:verify": "bash scripts/dev-bootstrap.sh --verify",
    "dev:down": "docker compose -f infra/docker-compose.yml down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "arch": "turbo run arch",
    "cycles": "turbo run cycles",
    "sdk:check": "node scripts/sdk-check.cjs",
    "shared-types:check": "node scripts/shared-types-check.cjs",
    "docs:api:build": "node scripts/docs-api-build.cjs",
    "docs:erd": "node scripts/docs-emit-erd.mjs",
    "docs:erd:check": "node scripts/docs-emit-erd.mjs --check",
    "docs:env:check": "node scripts/docs-env-check.cjs",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "docs:links": "lychee --config lychee.toml './**/*.md'",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "cover:unit": "pnpm --filter=api cover:unit",
    "mutate": "pnpm --filter=api mutate",
    "audit:critical": "node scripts/audit-gate.cjs --level=critical --fail-on-finding",
    "audit:high": "node scripts/audit-gate.cjs --level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.9.4",
    "turbo": "^2.10.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.8.5"
    }
  }
}
