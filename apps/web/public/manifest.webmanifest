{
  "name": "TravelSuperApp",
  "short_name": "Travel",
  "description": "Mobile-first, AI-powered travel super-app. Plan, navigate, and live the trip — even offline.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#fdfcf9",
  "background_color": "#fdfcf9",
  "lang": "en",
  "dir": "ltr",
  "categories": ["travel", "navigation", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon-any.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Plan a trip",
      "short_name": "Plan",
      "description": "Open the AI travel planner",
      "url": "/trips/new",
      "icons": [{ "src": "/icons/icon-any.svg", "sizes": "any" }]
    },
    {
      "name": "Navigate",
      "short_name": "Navigate",
      "description": "Open the offline-capable map",
      "url": "/navigate",
      "icons": [{ "src": "/icons/icon-any.svg", "sizes": "any" }]
    },
    {
      "name": "Diary",
      "short_name": "Diary",
      "description": "Open your travel diary",
      "url": "/diary",
      "icons": [{ "src": "/icons/icon-any.svg", "sizes": "any" }]
    }
  ]
}
