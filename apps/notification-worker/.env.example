# notification-worker — environment variables.
#
# Copy to .env (or import via `flyctl secrets import`) and fill in.
# All providers are OPTIONAL; the worker logs+acks when env tuples
# are incomplete (Resend / Twilio / web-push each gracefully no-op).
#
# Installed by [S-B1] when the real dispatchers landed.

# ─── Required ────────────────────────────────────────────────────────
# BullMQ Redis (use rediss:// for TLS / Upstash).
REDIS_URL=redis://127.0.0.1:6379

# ─── Per-process knobs ───────────────────────────────────────────────
# Concurrency (jobs in flight per machine). Bump with caution — each
# concurrent job holds an SDK connection open.
WORKER_CONCURRENCY=10
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Email (Resend) — optional ───────────────────────────────────────
# https://resend.com → Create API Key. Verify your sender domain first.
# Set BOTH for emails to actually send; the From address must be on a
# verified domain or Resend rejects.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@travelsuperapp.local

# ─── SMS (Twilio) — optional, ALL-OR-NOTHING ─────────────────────────
# Acquire a phone number first; populate all three or the dispatcher
# stays disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Web Push (VAPID) — optional, ALL-OR-NOTHING ─────────────────────
# Generate: `npx web-push generate-vapid-keys` (commit the public key
# to .env.example never — only inject via secrets manager).
# VAPID_SUBJECT must be a mailto: URL or an https:// URL identifying
# the pushing service to push gateways.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@travelsuperapp.local
