# crawler-worker — environment variables.
#
# Copy to .env (or import via `flyctl secrets import`). Only REDIS_URL
# is required; provider keys are optional and the worker degrades
# gracefully — OSM Overpass is free and always-on.
#
# Installed by [S-B3] when the real provider fan-out landed.

# ─── Required ────────────────────────────────────────────────────────
# BullMQ Redis (use rediss:// for TLS / Upstash).
REDIS_URL=redis://127.0.0.1:6379

# ─── Per-process knobs ───────────────────────────────────────────────
# Concurrency is intentionally low — each job fans out to 1-3 external
# providers; raising this multiplies the rate-limit budget you spend.
WORKER_CONCURRENCY=2
LOG_LEVEL=info

# ─── OSM Overpass — free, always-on ─────────────────────────────────
# Defaults to the public free server at overpass-api.de. For higher
# throughput, self-host overpass-api against a regional .osm.pbf extract
# and point this var at the local URL (e.g. http://overpass.internal/api/interpreter).
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ─── Google Places (New) — optional, paid ────────────────────────────
# https://console.cloud.google.com → enable Places API (New) → create
# API key with appropriate restrictions. When unset, the worker skips
# Google and only crawls OSM + (optional) FSQ.
GOOGLE_PLACES_API_KEY=

# ─── Foursquare Places v3 — optional, paid (free tier ~1k/day) ──────
# https://foursquare.com/developers → Place API. Bearer-style auth.
FOURSQUARE_API_KEY=
