{
  "name": "crawler-worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ Worker consuming the `crawler-recrawl` queue — re-fetches places from Google + Foursquare + OSM, dedups, upserts.",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "ts-node --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@app/clock": "workspace:*",
    "@app/jobs": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/resilience": "workspace:*"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/node": "^25.9.1",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
