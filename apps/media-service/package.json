{
  "name": "media-service",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ Worker consuming the `media-variants` queue — Sharp variant generation (avif/webp/thumb) off the request path.",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "ts-node --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@app/jobs": "workspace:*",
    "@app/logger": "workspace:*",
    "@aws-sdk/client-s3": "^3.1079.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
