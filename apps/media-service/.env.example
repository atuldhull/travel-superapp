# media-service — environment variables.
#
# Copy to .env (or import via `flyctl secrets import`). All vars below
# are REQUIRED — the worker fail-fasts on boot if any are missing
# (S3 access is the worker's entire job; no graceful fallback).
#
# Installed by [S-B2] when the real Sharp pipeline landed.

# ─── Required ────────────────────────────────────────────────────────
# BullMQ Redis (use rediss:// for TLS / Upstash).
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible storage — MinIO locally, R2 / S3 / etc. in prod.
# `forcePathStyle: true` is set client-side so both addressing modes
# work without further config.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=travel-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password

# ─── Per-process knobs ───────────────────────────────────────────────
# Sharp is CPU-bound (libvips). Concurrency=4 fits a 512mb VM with
# headroom for the 1024w variant. Bump on a bigger VM only.
WORKER_CONCURRENCY=4
LOG_LEVEL=info
