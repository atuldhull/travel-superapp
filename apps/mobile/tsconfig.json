{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "paths": {
      "@app/sdk": ["../../packages/sdk/src/index.ts"],
      "@app/aether-canvas-shared": ["../../packages/aether-canvas-shared/src/index.ts"],
      "@app/aether-core": ["../../packages/aether-core/src/index.ts"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "expo-env.d.ts", ".expo/types/**/*.ts"],
  "exclude": ["node_modules"]
}
