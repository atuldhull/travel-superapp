# Mobile environment variables — example values + documentation.
#
# Copy to `.env.local` (gitignored) and fill in real values.
# Expo automatically picks up `EXPO_PUBLIC_*` vars at build time and
# exposes them via `Constants.expoConfig.extra` or directly through
# `process.env.EXPO_PUBLIC_*` in JS.
#
# Non-`EXPO_PUBLIC_*` vars stay server-side and are not bundled into
# the client binary.

# ---------- Phase 4 feature flag ----------
# Mirror of web's NEXT_PUBLIC_FEATURE_AETHER_PHASE1. When set to '1'
# the Aether mobile surfaces (Pulse glow, Drift home, etc.) render
# above the 1.0 routes. Leave unset / '0' to suppress them.
# Defaults to '1' in the development + preview EAS profiles;
# unset in production until launch-ready.
EXPO_PUBLIC_FEATURE_AETHER_PHASE1=1

# ---------- API base URL ----------
# Set per-environment via eas.json's `env` block. Override here for
# local development against your own backend.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ---------- WebTransport feed endpoints (Continuum + live trip-watch) ----------
# Operator-owed before launch — the WT_FEED_URL + WT_PRESENCE_URL
# values come from the WebTransport server config (see
# docs/aether/01-architecture.md). Leave blank during local dev — the
# Continuum bar + live-trip-watch gracefully fall back to QR + polling.
EXPO_PUBLIC_WT_FEED_URL=
EXPO_PUBLIC_WT_PRESENCE_URL=

# ---------- Stripe publishable key (Vault — Phase 2 ports later) ----------
# Required when the Vault native checkout surface ships. Use the
# 'pk_test_*' key in dev; the 'pk_live_*' key only in production
# builds.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_ME_SEE_DOPPLER

# ---------- Push notifications ----------
# Operator owns the APNs key + FCM service account via
# `eas credentials`. No env var needed in JS — the tokens are fetched
# at runtime via `usePushNotifications` (lib/use-push-notifications.ts).

# ---------- Build SHA + time (optional, web-style) ----------
# Mirrors apps/web's NEXT_PUBLIC_BUILD_SHA + NEXT_PUBLIC_BUILD_TIME.
# Set by CI per build so the about / debug screen can show "you're
# running v1.0.0 (abc123) built 2026-06-01T12:00:00Z".
EXPO_PUBLIC_BUILD_SHA=
EXPO_PUBLIC_BUILD_TIME=
