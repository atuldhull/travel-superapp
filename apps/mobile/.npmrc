; V.UX.27 — apps/mobile is excluded from the root pnpm workspace
; (see pnpm-workspace.yaml comment). Run pnpm install from THIS
; directory only — `pnpm install --ignore-workspace` ensures the
; root lockfile isn't touched and Expo's React 18 deps don't leak
; into apps/web's @types/react@19 resolution.
ignore-workspace=true
auto-install-peers=true
node-linker=isolated
