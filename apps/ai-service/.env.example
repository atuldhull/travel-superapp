# ai-service — environment variables.
#
# Copy to .env (or pass via `flyctl secrets import`). Every var below
# is OPTIONAL; the FastAPI service boots with stub fallbacks for every
# endpoint when its real backend isn't configured.
#
# Installed by [S-A1].

# ─── Server ──────────────────────────────────────────────────────────
# Uvicorn bind port. Default 8001 if unset.
PORT=8001
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=info

# ─── Ollama embeddings (A1) — optional ───────────────────────────────
# Set to your Ollama HTTP base (default for a local install).
# When unset, /v1/embeddings returns deterministic-fake 1024-dim vectors
# (same response shape; observability via the `model` field).
OLLAMA_URL=http://127.0.0.1:11434
# Embedding model name. Default `mxbai-embed-large` (1024 dims, matches
# the PlaceEmbedding vector(1024) column in Prisma).
EMBEDDING_MODEL=mxbai-embed-large

# ─── Whisper STT (A3) — optional ─────────────────────────────────────
# Only active when the [stt] extras are installed:
#   `pip install '.[stt]'`
# faster-whisper compute type. `int8` is the smallest + fastest on CPU.
# Bump to `float16` on GPU.
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# ─── Argos translation (A2) — optional ───────────────────────────────
# Only active when the [translate] extras are installed:
#   `pip install '.[translate]'`
# Argos downloads the model package per (src,tgt) pair on first use;
# no further config needed here.

# ─── OpenTelemetry — optional ────────────────────────────────────────
# Honeycomb / Tempo / Grafana Cloud all speak OTLP/HTTP. The instrumentor
# stays no-op when these are absent (see ai_service/main.py).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your_key
# OTEL_SERVICE_NAME=ai-service
