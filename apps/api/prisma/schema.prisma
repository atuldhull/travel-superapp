// Prisma schema for TravelSuperApp — 43 models across 15 stateful bounded
// contexts from `docs/architecture/context-map.md`. Translation and
// Analytics contexts own no models (by design). Any drift between this
// file and the context-map is a PR-blocker.
//
// Conventions:
//   - Primary keys are `String @id @default(cuid())` unless the row is a
//     natural primary key (e.g. PlaceEmbedding keyed by placeId, or pure
//     join tables).
//   - Every row has `createdAt` + `updatedAt` unless marked append-only
//     (logs, forecasts).
//   - Soft-delete is User-only (GDPR erasure flow). Everything else is
//     hard-deleted; see Playbook §12.6 "pick one" rule.
//   - Geography columns use `Unsupported("geography(Point, 4326)")`
//     (PostGIS) and MUST be inserted via the forthcoming `GeoQueries`
//     service — CLAUDE.md rule 11.
//   - Vector columns use `Unsupported("vector(1024)")` (pgvector) and go
//     through `VectorQueries`.
//   - PII fields (email, phone) are stored encrypted via pgcrypto and
//     also hashed with a pepper (`emailHash`) for equality lookup —
//     Playbook §13.11.
//
// Installed by prompt [III.12.1]. See Playbook §12.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "tracing"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector, pg_trgm, pgcrypto]
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum UserRole {
  user
  premium
  agent
  admin
}

enum TripStatus {
  draft
  published
  archived
}

enum AgentKycStatus {
  pending
  verified
  rejected
}

enum ScamSeverity {
  low
  medium
  high
  critical
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}

enum EscrowState {
  held
  released
  refunded
  disputed
}

enum NotificationChannel {
  push
  email
  sms
}

enum NotificationDeliveryStatus {
  queued
  delivered
  suppressed
  failed
}

enum MediaStatus {
  processing
  ready
  failed
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum LiveEventKind {
  geofence_entered
  geofence_exited
  replan_triggered
  quiet_hours_entered
  quiet_hours_exited
}

enum TransportMode {
  walk
  public_transit
  bicycle
  two_wheeler
  car
  taxi
  rideshare
}

// ─── 1. Identity ────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  // Equality-lookup hash over pepper + email (Playbook §13.11). Never store
  // raw email in plaintext; the encrypted form lives in `emailEncrypted`.
  emailHash       String    @unique
  emailEncrypted  Bytes
  passwordHash    String? // argon2id; null for OAuth-only users
  role            UserRole  @default(user)
  displayName     String
  avatarUrl       String?
  locale          String    @default("en")
  timezone        String    @default("UTC")
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String? // TOTP secret; null when mfaEnabled=false
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Soft-delete: GDPR erasure marks this, purger sweeps later.
  deletedAt       DateTime?

  preferences        Preferences?
  sessions           Session[]
  mfaBackupCodes     MfaBackupCode[]
  devices            Device[]
  trips              Trip[]
  tripVersions       TripVersion[]
  tripShares         TripShare[]
  votes              Vote[]
  expenses           Expense[]
  reviews            Review[]
  mediaAssets        MediaAsset[]
  memoryBooks        MemoryBook[]
  subscriptions      Subscription[]
  escrowHolds        EscrowHold[]
  commissions        Commission[]
  scamReports        ScamReport[]
  sosEvents          SosEvent[]
  stayBookings       StayBooking[]
  notificationPrefs  NotificationPreference?
  notificationLogs   NotificationLog[]
  liveEvents         LiveEvent[]
  agent              Agent?
  dishReports        Dish[]
  moderationActions  ModerationItem[] @relation("ModerationActor")
  oauthIdentities    UserOAuthIdentity[]

  @@index([role])
  @@index([deletedAt])
}

// Links a user to an external OAuth provider identity. The
// `(provider, providerUserId)` tuple is the stable identity —
// providers like Google expose this as the `sub` claim on the ID
// token and it doesn't change when the user's email does.
//
// Installed by prompt [III.13.2.6]. Future providers (Apple, etc.)
// share this same row shape; each provider name is just a string.
model UserOAuthIdentity {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Short provider name: "google" | "apple" | "mock" (tests/dev).
  provider       String
  // The provider's stable user id (e.g. Google `sub` claim).
  providerUserId String
  // Email reported by the provider at link time. Useful for audit +
  // for surfacing "you've linked your Google account as foo@bar.com"
  // in settings. Can drift from User.email over time.
  providerEmail  String?
  linkedAt       DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenH      String    @unique // sha256(refresh_token) — never store raw
  deviceId           String?
  device             Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userAgent          String?
  ipHash             String? // sha256(ip + pepper) — Playbook §13.4
  // sha256(pepper + userAgent) at issuance time. Compared against a
  // freshly-computed fingerprint on every /refresh. Nullable only so
  // rows inserted before this column existed don't break the schema.
  // New rows always populate it. Added by [III.13.2] part 3.
  deviceFingerprint  String?
  issuedAt           DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Single-use, short-TTL passwordless sign-in token. Issued by
// `POST /auth/magic-link/request`; consumed by
// `POST /auth/magic-link/consume`. The plaintext token is sent by
// email and never stored — only `tokenHash` (sha256(token + pepper))
// lives in the database. Existing users get an immediate session;
// first-time emails create a new password-less User row at consume
// time.
//
// Installed by prompt [V.UX.2].
model MagicLinkToken {
  id          String    @id @default(cuid())
  // Hash of the email so repeat requests against the same address
  // can be quickly counted for rate-limiting + GDPR-friendly
  // (no plaintext addresses sitting around).
  emailHash   String
  // sha256(token + pepper) — never store raw token.
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([emailHash, createdAt])
  @@index([expiresAt])
}

// Single-use MFA recovery codes. Issued at enrolment (10 at a time)
// + on explicit /mfa/backup-codes/regenerate. `codeHash` is sha256
// of (BACKUP_CODE_PEPPER + plaintext) — the plaintext is returned
// ONCE at generation and never stored.
// Installed by [III.13.2] part 5.
model MfaBackupCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model Preferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diet           String[] // vegetarian, vegan, halal, kosher, gluten_free, ...
  accessibility  String[] // wheelchair, low_vision, ...
  travelType     String[] // solo, couple, family, business, ...
  budgetTier     Int      @default(2) // 1 (budget) .. 5 (luxury)
  dnd            Json? // quiet-hours rules: { start: "22:00", end: "07:00", tz }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Device {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String // ios | android | web
  pushToken       String?
  fingerprint     String // client-derived hash; used for refresh-token binding
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]

  @@unique([userId, fingerprint])
  @@index([pushToken])
}

// ─── 2. Trip Planning ───────────────────────────────────────────────────

model Trip {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  status    TripStatus @default(draft)
  // Domain center (PostGIS). Insert/update via GeoQueries ONLY.
  center    Unsupported("geography(Point, 4326)")
  radiusKm  Float
  startsOn  DateTime?
  endsOn    DateTime?
  version   Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  days     ItineraryDay[]
  versions TripVersion[]
  shares   TripShare[]
  votes    Vote[]
  expenses Expense[]
  reviews  Review[]
  media    MediaAsset[]
  liveEvents LiveEvent[]

  @@index([userId, status, createdAt])
}

model ItineraryDay {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayIndex  Int
  date      DateTime
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ItineraryItem[]

  @@unique([tripId, dayIndex])
}

model ItineraryItem {
  id              String       @id @default(cuid())
  dayId           String
  day             ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  position        Int
  placeId         String?
  place           Place?       @relation(fields: [placeId], references: [id], onDelete: SetNull)
  startTime       DateTime?
  endTime         DateTime?
  notes           String?
  transportMode   TransportMode?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([dayId, position])
  @@index([placeId])
}

model TripVersion {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  versionNo  Int
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  snapshot   Json // full trip shape at that version
  diff       Json? // optional diff vs. previous version
  note       String?
  createdAt  DateTime @default(now())

  @@unique([tripId, versionNo])
}

// ─── 3. Places Catalog ──────────────────────────────────────────────────

model Place {
  id             String   @id @default(cuid())
  sourceKey      String   @unique // sha256(provider + providerId) — dedup anchor
  name           String
  category       String
  coordinates    Unsupported("geography(Point, 4326)")
  // `ST_DWithin` + GiST index on `coordinates`; managed in raw SQL migration.
  address        String?
  countryCode    String?
  relaxationScore Float   @default(0) // 0..1
  metadata       Json? // provider-specific extras
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tags       PlaceTag[]
  embedding  PlaceEmbedding?
  items      ItineraryItem[]
  eateries   Eatery[]
  stays      Stay[]
  weather    WeatherForecast[]
  events     Event[]
  geofences  Geofence[]

  @@index([category])
  @@index([countryCode])
}

model PlaceTag {
  id      String @id @default(cuid())
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  key     String
  value   String

  @@unique([placeId, key])
  @@index([key, value])
}

model PlaceEmbedding {
  placeId   String @id
  place     Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  model     String // e.g. "voyage-large-2-instruct@2026-02"
  embedding Unsupported("vector(1024)")
  updatedAt DateTime @updatedAt
}

// ─── 4. Stays ───────────────────────────────────────────────────────────

model Stay {
  id           String   @id @default(cuid())
  placeId      String?
  place        Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  name         String
  starRating   Float?
  amenities    String[]
  coordinates  Unsupported("geography(Point, 4326)")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prices   StayPrice[]
  bookings StayBooking[]

  @@index([placeId])
}

model StayPrice {
  id         String   @id @default(cuid())
  stayId     String
  stay       Stay     @relation(fields: [stayId], references: [id], onDelete: Cascade)
  provider   String // booking | amadeus | airbnb-public | ...
  priceUsd   Decimal  @db.Decimal(10, 2)
  currency   String   @db.VarChar(3)
  checkIn    DateTime
  checkOut   DateTime
  scrapedAt  DateTime @default(now())
  sourceUrl  String

  @@index([stayId, scrapedAt])
  @@index([checkIn, checkOut])
}

model StayBooking {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stayId           String
  stay             Stay     @relation(fields: [stayId], references: [id], onDelete: Restrict)
  provider         String
  providerBookingId String
  checkIn          DateTime
  checkOut         DateTime
  totalPriceUsd    Decimal  @db.Decimal(10, 2)
  commissionUsd    Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, providerBookingId])
  @@index([userId, createdAt])
}

// ─── 5. Food & Tryouts ──────────────────────────────────────────────────

model Eatery {
  id           String   @id @default(cuid())
  placeId      String?
  place        Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  name         String
  cuisineTags  String[]
  priceTier    Int      @default(2) // 1..5
  coordinates  Unsupported("geography(Point, 4326)")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dishes Dish[]

  @@index([placeId])
}

model Dish {
  id         String   @id @default(cuid())
  eateryId   String
  eatery     Eatery   @relation(fields: [eateryId], references: [id], onDelete: Cascade)
  name       String
  priceUsd   Decimal? @db.Decimal(8, 2)
  reportedBy String?
  reporter   User?    @relation(fields: [reportedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tags DishTag[]

  @@index([eateryId])
}

model DishTag {
  id     String @id @default(cuid())
  dishId String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  key    String
  value  String

  @@unique([dishId, key])
  @@index([key, value])
}

// ─── 6. Transport & Routing ─────────────────────────────────────────────

model RouteLeg {
  id             String        @id @default(cuid())
  origin         Unsupported("geography(Point, 4326)")
  destination    Unsupported("geography(Point, 4326)")
  mode           TransportMode
  distanceMeters Int
  durationSec    Int
  polyline       String? // encoded polyline for rendering
  computedAt     DateTime      @default(now())

  @@index([mode])
}

model TransitSchedule {
  id           String   @id @default(cuid())
  routeName    String
  mode         TransportMode
  operator     String?
  validFrom    DateTime
  validTo      DateTime?
  payload      Json // GTFS-like structure
  updatedAt    DateTime @updatedAt

  @@index([routeName])
}

// ─── 7. Safety ──────────────────────────────────────────────────────────

model CrimeIncident {
  id           String   @id @default(cuid())
  source       String // numbeo | gov-<country> | user-report
  category     String
  severity     ScamSeverity @default(medium)
  coordinates  Unsupported("geography(Point, 4326)")
  reportedAt   DateTime
  createdAt    DateTime @default(now())

  @@index([source])
  @@index([reportedAt])
}

model ScamReport {
  id            String   @id @default(cuid())
  reporterId    String
  reporter      User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  category      String // fake-taxi | overcharge | pickpocket | ...
  severity      ScamSeverity @default(medium)
  coordinates   Unsupported("geography(Point, 4326)")
  description   String
  evidenceUrls  String[]
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([reporterId, createdAt])
  @@index([category])
}

model Agent {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  bio             String?
  kycStatus       AgentKycStatus @default(pending)
  kycProviderRef  String? // Sumsub / Persona reference
  verifiedAt      DateTime?
  languages       String[]
  regions         String[]
  ratingAverage   Float          @default(0)
  ratingCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  escrowHolds EscrowHold[]

  @@index([kycStatus])
}

model SosEvent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coordinates   Unsupported("geography(Point, 4326)")
  trigger       String // user_tap | fall_detected | geofence_exit | ...
  resolvedAt    DateTime?
  resolutionNote String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resolvedAt])
}

// ─── 8. Weather & Environment ───────────────────────────────────────────

model WeatherForecast {
  id           String   @id @default(cuid())
  placeId      String?
  place        Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  coordinates  Unsupported("geography(Point, 4326)")
  forecastFor  DateTime
  source       String // open-meteo | owm | waqi
  payload      Json // temperature, uv, aqi, etc.
  fetchedAt    DateTime @default(now())

  @@index([placeId, forecastFor])
  @@index([forecastFor])
}

model Alert {
  id           String   @id @default(cuid())
  source       String
  severity     ScamSeverity @default(medium) // reuse scale
  title        String
  body         String
  coordinates  Unsupported("geography(Point, 4326)")
  validFrom    DateTime
  validTo      DateTime?
  createdAt    DateTime @default(now())

  @@index([validFrom, validTo])
}

// ─── 9. Events & Culture ────────────────────────────────────────────────

// NOTE: the entity is named `Event` to match Playbook §7.2 even though
// it collides with domain-event terminology in prose. The context-map
// calls these "CulturalEvent" when ambiguity would bite.
model Event {
  id            String   @id @default(cuid())
  sourceKey     String   @unique // sha256(source + sourceId)
  placeId       String?
  place         Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  startsAt      DateTime
  endsAt        DateTime
  venueName     String?
  coordinates   Unsupported("geography(Point, 4326)")
  priceMin      Decimal? @db.Decimal(10, 2)
  priceMax      Decimal? @db.Decimal(10, 2)
  priceCurrency String?  @db.VarChar(3)
  sourceId      String
  source        EventSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startsAt])
  @@index([placeId])
}

model EventSource {
  id          String   @id @default(cuid())
  name        String   @unique // meetup | eventbrite-public | local-<slug>
  baseUrl     String
  robotsOk    Boolean  @default(true)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

// ─── 11. Live Companion ─────────────────────────────────────────────────

model Geofence {
  id            String   @id @default(cuid())
  placeId       String?
  place         Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  center        Unsupported("geography(Point, 4326)")
  radiusMeters  Int
  label         String
  activeFrom    DateTime @default(now())
  activeUntil   DateTime?
  createdAt     DateTime @default(now())

  liveEvents LiveEvent[]
}

model LiveEvent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  geofenceId  String?
  geofence    Geofence?     @relation(fields: [geofenceId], references: [id], onDelete: SetNull)
  kind        LiveEventKind
  payload     Json?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([tripId, createdAt])
}

// ─── 12. Social & Groups ────────────────────────────────────────────────

model TripShare {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shareCode  String   @unique
  publicRead Boolean  @default(false)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

model Vote {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // itinerary_item | place | restaurant
  targetId   String
  value      Int // -1, 0, +1
  createdAt  DateTime @default(now())

  @@unique([tripId, userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Expense {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidById   String
  paidBy     User     @relation(fields: [paidById], references: [id], onDelete: Cascade)
  amountUsd  Decimal  @db.Decimal(10, 2)
  currency   String   @db.VarChar(3)
  note       String?
  splitShare Json // { userId: share } map
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tripId, createdAt])
}

model Review {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  targetType  String // place | stay | eatery | agent
  targetId    String
  rating      Int // 1..5
  body        String
  language    String   @default("en")
  verifiedBooking Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([authorId, createdAt])
}

// ─── 13. Media & Memory ─────────────────────────────────────────────────

model MediaAsset {
  id           String      @id @default(cuid())
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tripId       String?
  trip         Trip?       @relation(fields: [tripId], references: [id], onDelete: SetNull)
  memoryBookId String?
  memoryBook   MemoryBook? @relation(fields: [memoryBookId], references: [id], onDelete: SetNull)
  kind         String // image | video
  status       MediaStatus @default(processing)
  s3KeyRaw     String      @unique
  variants     Json? // [{ label, format, s3Key, width, height, bytes, sha256 }]
  exifStripped Boolean     @default(false)
  coordinates  Unsupported("geography(Point, 4326)")?
  takenAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ownerId, createdAt])
  @@index([tripId, createdAt])
  @@index([status])
}

model MemoryBook {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String
  coverS3Key String?
  theme      String   @default("classic")
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assets MediaAsset[]

  @@index([ownerId, createdAt])
}

// ─── 14. Payments ───────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(trialing)
  priceCents           Int
  currency             String             @db.VarChar(3)
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
}

model EscrowHold {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId             String
  agent               Agent       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  amountUsd           Decimal     @db.Decimal(10, 2)
  currency            String      @db.VarChar(3)
  stripePaymentIntent String      @unique
  state               EscrowState @default(held)
  heldAt              DateTime    @default(now())
  releasedAt          DateTime?
  refundedAt          DateTime?

  @@index([userId, state])
  @@index([agentId, state])
}

model Commission {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType        String // stay_booking | agent_service
  sourceId          String
  amountUsd         Decimal  @db.Decimal(10, 2)
  currency          String   @db.VarChar(3)
  paidAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── 15. Notifications ──────────────────────────────────────────────────

model NotificationPreference {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  push         Boolean @default(true)
  email        Boolean @default(true)
  sms          Boolean @default(false)
  quietHours   Json? // { start: "22:00", end: "07:00", tz }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NotificationLog {
  id                 String                     @id @default(cuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel            NotificationChannel
  templateId         String
  status             NotificationDeliveryStatus @default(queued)
  providerMessageId  String?
  payload            Json
  errorMessage       String?
  attempts           Int                        @default(0)
  read               Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  deliveredAt        DateTime?

  @@index([userId, read, createdAt])
  @@index([status, createdAt])
}

// ─── 17. Admin & Ops ────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(admin)
  mfaEnabled   Boolean  @default(true)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ModerationItem {
  id             String           @id @default(cuid())
  targetType     String // review | scam_report | media_asset | agent
  targetId       String
  reason         String
  status         ModerationStatus @default(pending)
  actorId        String? // admin who resolved
  actor          User?            @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  decisionNote   String?
  createdAt      DateTime         @default(now())
  decidedAt      DateTime?

  @@unique([targetType, targetId])
  @@index([status, createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique // feature.3d.enabled | scraper.booking.enabled | ...
  description String
  enabled     Boolean  @default(false)
  rollout     Json? // { percentage: 10 } | { cohort: "beta" } | etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
