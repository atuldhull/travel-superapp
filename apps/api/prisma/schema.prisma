// Prisma schema for TravelSuperApp — 46 models across 15 stateful bounded
// contexts from `docs/architecture/context-map.md`. Translation and
// Analytics contexts own no models (by design). Any drift between this
// file and the context-map is a PR-blocker.
//
// Conventions:
//   - Primary keys are `String @id @default(cuid())` unless the row is a
//     natural primary key (e.g. PlaceEmbedding keyed by placeId, or pure
//     join tables).
//   - Every row has `createdAt` + `updatedAt` unless marked append-only
//     (logs, forecasts).
//   - Soft-delete is User-only (GDPR erasure flow). Everything else is
//     hard-deleted; see Playbook §12.6 "pick one" rule.
//   - Geography columns use `Unsupported("geography(Point, 4326)")`
//     (PostGIS) and MUST be inserted via the forthcoming `GeoQueries`
//     service — CLAUDE.md rule 11.
//   - Vector columns use `Unsupported("vector(1024)")` (pgvector) and go
//     through `VectorQueries`.
//   - PII fields (email, phone) are stored encrypted via pgcrypto and
//     also hashed with a pepper (`emailHash`) for equality lookup —
//     Playbook §13.11.
//
// Installed by prompt [III.12.1]. See Playbook §12.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "tracing"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector, pg_trgm, pgcrypto]
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum UserRole {
  user
  premium
  agent
  admin
  // V.UX.37 — read-only audit/retention/takedown reporting role.
  // Strictly weaker than `admin`: can read /compliance/* surfaces
  // (retention dashboard + takedown list) but cannot ban / verify /
  // resolve / delete. Promoted by an admin via a future tooling flow.
  compliance
  // V.UX.38 — site reliability engineer. Read-only access to the
  // /ops dashboard (health probes + runbook index + force-purge).
  // Cannot perform destructive moderation actions.
  sre
}

enum TripStatus {
  draft
  published
  archived
}

enum AgentKycStatus {
  pending
  verified
  rejected
}

enum ScamSeverity {
  low
  medium
  high
  critical
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}

enum EscrowState {
  held
  released
  refunded
  disputed
}

enum NotificationChannel {
  push
  email
  sms
}

enum NotificationDeliveryStatus {
  queued
  delivered
  suppressed
  failed
}

enum MediaStatus {
  processing
  ready
  failed
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum LiveEventKind {
  geofence_entered
  geofence_exited
  replan_triggered
  quiet_hours_entered
  quiet_hours_exited
}

enum TransportMode {
  walk
  public_transit
  bicycle
  two_wheeler
  car
  taxi
  rideshare
}

// ─── 1. Identity ────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  // Equality-lookup hash over pepper + email (Playbook §13.11). Never store
  // raw email in plaintext; the encrypted form lives in `emailEncrypted`.
  emailHash         String    @unique
  emailEncrypted    Bytes
  passwordHash      String? // argon2id; null for OAuth-only users
  role              UserRole  @default(user)
  displayName       String
  avatarUrl         String?
  locale            String    @default("en")
  timezone          String    @default("UTC")
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String? // TOTP secret; null when mfaEnabled=false
  // Flips to true the first time the user completes (or skips) the
  // 3-step onboarding wizard. Used by the web client to decide whether
  // to bounce post-login → /onboarding or → /trips.
  // Installed by prompt [V.UX.3].
  hasSeenOnboarding Boolean   @default(false)
  // V.UX.30 — last sign-in / /auth/me hit timestamps. The welcome-back
  // hero compares `previousSeenAt` (the visit BEFORE the current one)
  // against now() — gap > 30 days fires the hero. /auth/me swaps
  // lastSeenAt → previousSeenAt on every hit.
  lastSeenAt        DateTime?
  previousSeenAt    DateTime?
  // V.UX.34 — admin-driven ban. Distinct from `deletedAt` so a user
  // who reactivates via the V.UX.33 link still can't log in if they
  // remain banned. `banReason` is shown to the user on the banned-
  // login page.
  bannedAt          DateTime?
  banReason         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Soft-delete: GDPR erasure marks this, purger sweeps later.
  deletedAt         DateTime?

  preferences       Preferences?
  sessions          Session[]
  mfaBackupCodes    MfaBackupCode[]
  devices           Device[]
  trips             Trip[]
  tripVersions      TripVersion[]
  tripShares        TripShare[]
  votes             Vote[]
  expenses          Expense[]
  reviews           Review[]
  mediaAssets       MediaAsset[]
  memoryBooks       MemoryBook[]
  subscriptions     Subscription[]
  escrowHolds       EscrowHold[]
  commissions       Commission[]
  scamReports       ScamReport[]
  sosEvents         SosEvent[]
  trustedContacts   TrustedContact[]
  stayBookings      StayBooking[]
  notificationPrefs NotificationPreference?
  notificationLogs  NotificationLog[]
  pushSubscriptions PushSubscription[]
  liveEvents        LiveEvent[]
  agent             Agent?
  dishReports       Dish[]
  moderationActions ModerationItem[]        @relation("ModerationActor")
  // V.UX.36 — admin audit log (admin actions performed by this user).
  adminAuditLogs    AdminAuditLog[]         @relation("AdminAuditActor")
  oauthIdentities   UserOAuthIdentity[]
  // V.UX.25 — reviewer karma + helpful-vote relations.
  karma             UserKarma?
  helpfulVotes      HelpfulVote[]
  // V.UX.34 — ban-appeal queue.
  banAppeals        BanAppeal[]

  @@index([role])
  @@index([deletedAt])
  @@index([bannedAt])
}

// V.UX.34 — ban-appeal queue. Append-only; admin triages by status.
// emailHash lets the (un-authed) submit endpoint look up the user
// without leaking plaintext + supports per-email rate-limiting.
model BanAppeal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailHash String
  body      String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([emailHash, createdAt])
}

// Links a user to an external OAuth provider identity. The
// `(provider, providerUserId)` tuple is the stable identity —
// providers like Google expose this as the `sub` claim on the ID
// token and it doesn't change when the user's email does.
//
// Installed by prompt [III.13.2.6]. Future providers (Apple, etc.)
// share this same row shape; each provider name is just a string.
model UserOAuthIdentity {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Short provider name: "google" | "apple" | "mock" (tests/dev).
  provider       String
  // The provider's stable user id (e.g. Google `sub` claim).
  providerUserId String
  // Email reported by the provider at link time. Useful for audit +
  // for surfacing "you've linked your Google account as foo@bar.com"
  // in settings. Can drift from User.email over time.
  providerEmail  String?
  linkedAt       DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenH     String    @unique // sha256(refresh_token) — never store raw
  deviceId          String?
  device            Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userAgent         String?
  ipHash            String? // sha256(ip + pepper) — Playbook §13.4
  // sha256(pepper + userAgent) at issuance time. Compared against a
  // freshly-computed fingerprint on every /refresh. Nullable only so
  // rows inserted before this column existed don't break the schema.
  // New rows always populate it. Added by [III.13.2] part 3.
  deviceFingerprint String?
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Single-use, short-TTL passwordless sign-in token. Issued by
// `POST /auth/magic-link/request`; consumed by
// `POST /auth/magic-link/consume`. The plaintext token is sent by
// email and never stored — only `tokenHash` (sha256(token + pepper))
// lives in the database. Existing users get an immediate session;
// first-time emails create a new password-less User row at consume
// time.
//
// Installed by prompt [V.UX.2].
model MagicLinkToken {
  id         String    @id @default(cuid())
  // Hash of the email so repeat requests against the same address
  // can be quickly counted for rate-limiting + GDPR-friendly
  // (no plaintext addresses sitting around).
  emailHash  String
  // sha256(token + pepper) — never store raw token.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([emailHash, createdAt])
  @@index([expiresAt])
}

// V.UX.31 — password-reset tokens. Sibling to MagicLinkToken with the
// same single-use semantics: row exists, not consumed, not expired
// → atomic `updateMany` consume claims it. The plaintext is sent in
// the email link only; we store sha256(EMAIL_PEPPER + token).
model PasswordResetToken {
  id         String    @id @default(cuid())
  emailHash  String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([emailHash, createdAt])
  @@index([expiresAt])
}

// Single-use MFA recovery codes. Issued at enrolment (10 at a time)
// + on explicit /mfa/backup-codes/regenerate. `codeHash` is sha256
// of (BACKUP_CODE_PEPPER + plaintext) — the plaintext is returned
// ONCE at generation and never stored.
// Installed by [III.13.2] part 5.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model Preferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diet           String[] // vegetarian, vegan, halal, kosher, gluten_free, ...
  accessibility  String[] // wheelchair, low_vision, ...
  travelType     String[] // solo, couple, family, business, ...
  budgetTier     Int      @default(2) // 1 (budget) .. 5 (luxury)
  dnd            Json? // quiet-hours rules: { start: "22:00", end: "07:00", tz }
  // V.UX.14 — family-mode persona. When enabled, the search forms
  // auto-add family filter chips (kid_friendly, stroller_accessible,
  // high_chair, crib) and the trip detail page surfaces a pacing
  // warning when a day has > 4 items.
  familyMode     Boolean  @default(false)
  kidAges        Int[] // ages of any travelling children, 0..17
  // V.UX.15 — accessibility / senior persona. When enabled, the web
  // client applies a `.comfort` class on `<html>` that bumps font
  // size + line-height + tap-target padding, and transport searches
  // default `stepFreeOnly: true`.
  comfortMode    Boolean  @default(false)
  // V.UX.16 — budget-backpacker persona. When `budgetMode = true`
  // search forms hide listings priced above the user's tier and the
  // trip detail page surfaces a sticky "Today's spend: $X / $Y"
  // banner that pulls from the existing Expense rows. `dailyBudgetUsd`
  // is the daily target in USD (null = no target set yet but mode
  // can still be on).
  budgetMode     Boolean  @default(false)
  dailyBudgetUsd Decimal? @db.Decimal(10, 2)
  // V.UX.23 — digital-nomad persona. When enabled, the stays search
  // form defaults to a 4-week window + the wifi-speed slider, and
  // the home page surfaces the connectivity-info link.
  nomadMode      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String // ios | android | web
  pushToken   String?
  fingerprint String // client-derived hash; used for refresh-token binding
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]

  @@unique([userId, fingerprint])
  @@index([pushToken])
}

// ─── 2. Trip Planning ───────────────────────────────────────────────────

model Trip {
  id         String                                @id @default(cuid())
  userId     String
  user       User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  status     TripStatus                            @default(draft)
  // Domain center (PostGIS). Insert/update via GeoQueries ONLY.
  center     Unsupported("geography(Point, 4326)")
  radiusKm   Float
  startsOn   DateTime?
  endsOn     DateTime?
  version    Int                                   @default(1)
  // V.UX.30 — soft-archive. Auto-stamped by the daily sweep when
  // createdAt > 365 days; manual via POST /trips/:id/archive. Default
  // lister filters `archivedAt IS NULL`.
  archivedAt DateTime?
  createdAt  DateTime                              @default(now())
  updatedAt  DateTime                              @updatedAt

  days       ItineraryDay[]
  versions   TripVersion[]
  shares     TripShare[]
  votes      Vote[]
  expenses   Expense[]
  reviews    Review[]
  media      MediaAsset[]
  liveEvents LiveEvent[]

  @@index([userId, status, createdAt])
  @@index([userId, archivedAt, createdAt])
}

model ItineraryDay {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayIndex  Int
  date      DateTime
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ItineraryItem[]

  @@unique([tripId, dayIndex])
}

model ItineraryItem {
  id            String         @id @default(cuid())
  dayId         String
  day           ItineraryDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  position      Int
  placeId       String?
  place         Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)
  startTime     DateTime?
  endTime       DateTime?
  notes         String?
  transportMode TransportMode?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([dayId, position])
  @@index([placeId])
}

model TripVersion {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  versionNo Int
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  snapshot  Json // full trip shape at that version
  diff      Json? // optional diff vs. previous version
  note      String?
  createdAt DateTime @default(now())

  @@unique([tripId, versionNo])
}

// ─── 3. Places Catalog ──────────────────────────────────────────────────

model Place {
  id              String                                @id @default(cuid())
  sourceKey       String                                @unique // sha256(provider + providerId) — dedup anchor
  name            String
  category        String
  coordinates     Unsupported("geography(Point, 4326)")
  // `ST_DWithin` + GiST index on `coordinates`; managed in raw SQL migration.
  address         String?
  countryCode     String?
  relaxationScore Float                                 @default(0) // 0..1
  // V.UX.21 — provider-specific extras. Adventure persona conventions
  // (no schema migration needed; metadata is free-form JSON):
  //   - difficulty: 'easy' | 'moderate' | 'hard' | 'expert'
  //   - elevationM: number  (peak elevation, metres)
  //   - activityType: 'hike' | 'climb' | 'kayak' | 'surf' | 'cycle' | ...
  // V.UX.22 — cultural / religious persona conventions:
  //   - etiquette: string  (free-text — "remove shoes", "no flash photography")
  //   - dressCode: string  (free-text — "shoulders + knees covered")
  //   - venueType: 'temple' | 'mosque' | 'church' | 'synagogue' | 'shrine' | ...
  // V.UX.23 — digital-nomad persona: `category = 'coworking'` is the
  // canonical slug for co-working venues; metadata may carry
  // `wifiSpeedMbps: number` + `desksAvailable: number` extras.
  metadata        Json? // provider-specific extras
  createdAt       DateTime                              @default(now())
  updatedAt       DateTime                              @updatedAt

  tags      PlaceTag[]
  embedding PlaceEmbedding?
  items     ItineraryItem[]
  eateries  Eatery[]
  stays     Stay[]
  weather   WeatherForecast[]
  events    Event[]
  geofences Geofence[]

  @@index([category])
  @@index([countryCode])
}

model PlaceTag {
  id      String @id @default(cuid())
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  key     String
  value   String

  @@unique([placeId, key])
  @@index([key, value])
}

model PlaceEmbedding {
  placeId   String                      @id
  place     Place                       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  model     String // e.g. "voyage-large-2-instruct@2026-02"
  embedding Unsupported("vector(1024)")
  updatedAt DateTime                    @updatedAt
}

// ─── 4. Stays ───────────────────────────────────────────────────────────

model Stay {
  id            String                                @id @default(cuid())
  placeId       String?
  place         Place?                                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  name          String
  starRating    Float?
  amenities     String[]
  // V.UX.23 — digital-nomad persona: posted average wifi speed (Mbps).
  // Surfaced alongside other listing fields so the nomad-mode UI can
  // filter / sort. Null when the provider doesn't report it.
  wifiSpeedMbps Int?
  coordinates   Unsupported("geography(Point, 4326)")
  createdAt     DateTime                              @default(now())
  updatedAt     DateTime                              @updatedAt

  prices   StayPrice[]
  bookings StayBooking[]

  @@index([placeId])
}

model StayPrice {
  id        String   @id @default(cuid())
  stayId    String
  stay      Stay     @relation(fields: [stayId], references: [id], onDelete: Cascade)
  provider  String // booking | amadeus | airbnb-public | ...
  priceUsd  Decimal  @db.Decimal(10, 2)
  currency  String   @db.VarChar(3)
  checkIn   DateTime
  checkOut  DateTime
  scrapedAt DateTime @default(now())
  sourceUrl String

  @@index([stayId, scrapedAt])
  @@index([checkIn, checkOut])
}

model StayBooking {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stayId            String
  stay              Stay     @relation(fields: [stayId], references: [id], onDelete: Restrict)
  provider          String
  providerBookingId String
  checkIn           DateTime
  checkOut          DateTime
  totalPriceUsd     Decimal  @db.Decimal(10, 2)
  commissionUsd     Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerBookingId])
  @@index([userId, createdAt])
}

// ─── 5. Food & Tryouts ──────────────────────────────────────────────────

model Eatery {
  id          String                                @id @default(cuid())
  placeId     String?
  place       Place?                                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  name        String
  cuisineTags String[]
  priceTier   Int                                   @default(2) // 1..5
  coordinates Unsupported("geography(Point, 4326)")
  createdAt   DateTime                              @default(now())
  updatedAt   DateTime                              @updatedAt

  dishes Dish[]

  @@index([placeId])
}

model Dish {
  id         String   @id @default(cuid())
  eateryId   String
  eatery     Eatery   @relation(fields: [eateryId], references: [id], onDelete: Cascade)
  name       String
  priceUsd   Decimal? @db.Decimal(8, 2)
  // V.UX.20 — foodie persona: optional photo + caption captured at
  // report time. photoUrl points to a publicly-readable URL (S3
  // pre-signed GET or external URL). caption is free-text, capped
  // in the use-case.
  photoUrl   String?
  caption    String?
  reportedBy String?
  reporter   User?    @relation(fields: [reportedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tags DishTag[]

  @@index([eateryId])
}

model DishTag {
  id     String @id @default(cuid())
  dishId String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  key    String
  value  String

  @@unique([dishId, key])
  @@index([key, value])
}

// ─── 6. Transport & Routing ─────────────────────────────────────────────

model RouteLeg {
  id             String                                @id @default(cuid())
  origin         Unsupported("geography(Point, 4326)")
  destination    Unsupported("geography(Point, 4326)")
  mode           TransportMode
  distanceMeters Int
  durationSec    Int
  polyline       String? // encoded polyline for rendering
  computedAt     DateTime                              @default(now())

  @@index([mode])
}

model TransitSchedule {
  id        String        @id @default(cuid())
  routeName String
  mode      TransportMode
  operator  String?
  validFrom DateTime
  validTo   DateTime?
  payload   Json // GTFS-like structure
  updatedAt DateTime      @updatedAt

  @@index([routeName])
}

// ─── 7. Safety ──────────────────────────────────────────────────────────

model CrimeIncident {
  id          String                                @id @default(cuid())
  source      String // numbeo | gov-<country> | user-report
  category    String
  severity    ScamSeverity                          @default(medium)
  coordinates Unsupported("geography(Point, 4326)")
  reportedAt  DateTime
  createdAt   DateTime                              @default(now())

  @@index([source])
  @@index([reportedAt])
}

model ScamReport {
  id           String                                @id @default(cuid())
  reporterId   String
  reporter     User                                  @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  category     String // fake-taxi | overcharge | pickpocket | ...
  severity     ScamSeverity                          @default(medium)
  coordinates  Unsupported("geography(Point, 4326)")
  description  String
  evidenceUrls String[]
  verified     Boolean                               @default(false)
  createdAt    DateTime                              @default(now())
  updatedAt    DateTime                              @updatedAt

  @@index([reporterId, createdAt])
  @@index([category])
}

model Agent {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  bio            String?
  kycStatus      AgentKycStatus @default(pending)
  kycProviderRef String? // Sumsub / Persona reference
  verifiedAt     DateTime?
  languages      String[]
  regions        String[]
  ratingAverage  Float          @default(0)
  ratingCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  escrowHolds EscrowHold[]

  @@index([kycStatus])
}

model SosEvent {
  id             String                                @id @default(cuid())
  userId         String
  user           User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  coordinates    Unsupported("geography(Point, 4326)")
  trigger        String // user_tap | fall_detected | geofence_exit | ...
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime                              @default(now())

  @@index([userId, createdAt])
  @@index([resolvedAt])
}

// V.UX.13 — pre-set safety contacts. Cap of 3 enforced in the
// use-case (no DB-level constraint; same approach as MfaBackupCode's
// per-user cap). On SOS trigger, these are fanned out via the
// stub SMS adapter (real Twilio lands in a follow-up).
model TrustedContact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// ─── 8. Weather & Environment ───────────────────────────────────────────

model WeatherForecast {
  id          String                                @id @default(cuid())
  placeId     String?
  place       Place?                                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  coordinates Unsupported("geography(Point, 4326)")
  forecastFor DateTime
  source      String // open-meteo | owm | waqi
  payload     Json // temperature, uv, aqi, etc.
  fetchedAt   DateTime                              @default(now())

  @@index([placeId, forecastFor])
  @@index([forecastFor])
}

model Alert {
  id          String                                @id @default(cuid())
  source      String
  severity    ScamSeverity                          @default(medium) // reuse scale
  title       String
  body        String
  coordinates Unsupported("geography(Point, 4326)")
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime                              @default(now())

  @@index([validFrom, validTo])
}

// ─── 9. Events & Culture ────────────────────────────────────────────────

// NOTE: the entity is named `Event` to match Playbook §7.2 even though
// it collides with domain-event terminology in prose. The context-map
// calls these "CulturalEvent" when ambiguity would bite.
model Event {
  id            String                                @id @default(cuid())
  sourceKey     String                                @unique // sha256(source + sourceId)
  placeId       String?
  place         Place?                                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  startsAt      DateTime
  endsAt        DateTime
  venueName     String?
  coordinates   Unsupported("geography(Point, 4326)")
  priceMin      Decimal?                              @db.Decimal(10, 2)
  priceMax      Decimal?                              @db.Decimal(10, 2)
  priceCurrency String?                               @db.VarChar(3)
  sourceId      String
  source        EventSource                           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdAt     DateTime                              @default(now())
  updatedAt     DateTime                              @updatedAt

  @@index([startsAt])
  @@index([placeId])
}

model EventSource {
  id        String   @id @default(cuid())
  name      String   @unique // meetup | eventbrite-public | local-<slug>
  baseUrl   String
  robotsOk  Boolean  @default(true)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

// ─── 11. Live Companion ─────────────────────────────────────────────────

model Geofence {
  id           String                                @id @default(cuid())
  placeId      String?
  place        Place?                                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  center       Unsupported("geography(Point, 4326)")
  radiusMeters Int
  label        String
  activeFrom   DateTime                              @default(now())
  activeUntil  DateTime?
  createdAt    DateTime                              @default(now())

  liveEvents LiveEvent[]
}

model LiveEvent {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  geofenceId String?
  geofence   Geofence?     @relation(fields: [geofenceId], references: [id], onDelete: SetNull)
  kind       LiveEventKind
  payload    Json?
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([tripId, createdAt])
}

// ─── 12. Social & Groups ────────────────────────────────────────────────

model TripShare {
  id         String    @id @default(cuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shareCode  String    @unique
  publicRead Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId])
}

model Vote {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // itinerary_item | place | restaurant
  targetId   String
  value      Int // -1, 0, +1
  createdAt  DateTime @default(now())

  @@unique([tripId, userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Expense {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidById   String
  paidBy     User     @relation(fields: [paidById], references: [id], onDelete: Cascade)
  amountUsd  Decimal  @db.Decimal(10, 2)
  currency   String   @db.VarChar(3)
  note       String?
  splitShare Json // { userId: share } map
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tripId, createdAt])
}

model Review {
  id              String    @id @default(cuid())
  authorId        String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tripId          String?
  trip            Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  targetType      String // place | stay | eatery | agent
  targetId        String
  rating          Int // 1..5
  body            String
  language        String    @default("en")
  verifiedBooking Boolean   @default(false)
  // V.UX.24 — agent (or other target owner) reply. Stamped at most
  // once per review (the use-case rejects re-submissions). The
  // V.UX.24 surface is agent-only; later slices may broaden to
  // place/stay/eatery owners.
  responseBody    String?
  responseAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // V.UX.25 — community "this review was helpful" upvotes. Distinct
  // from Vote (which is itinerary-item polling). One row per
  // (reviewer, voter) — the use-case enforces no-self-vote.
  helpfulVotes HelpfulVote[]

  @@index([targetType, targetId])
  @@index([authorId, createdAt])
}

// V.UX.25 — reviewer-karma surface. One row per user; populated on
// first helpful-vote received OR first scheduled recompute. The
// computed `score` is `(reviewCount * 1) + (helpfulVotesReceived * 2)`
// so a single helpful vote outweighs a single review — incentivises
// quality > quantity. `badges` is a flat string[] (e.g.
// `['contributor_10','helpful_100']`) so new badges land without a
// schema change.
model UserKarma {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score                Int      @default(0)
  reviewCount          Int      @default(0)
  helpfulVotesReceived Int      @default(0)
  badges               String[]
  recomputedAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([score])
}

// V.UX.25 — "I found this review helpful" upvote. One row per
// (reviewId, voterId). Self-votes rejected at the use-case (no DB
// constraint; reviewer + author look-up is cheap).
model HelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  voterId   String
  voter     User     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, voterId])
  @@index([voterId, createdAt])
}

// ─── 13. Media & Memory ─────────────────────────────────────────────────

model MediaAsset {
  id           String                                 @id @default(cuid())
  ownerId      String
  owner        User                                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tripId       String?
  trip         Trip?                                  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  memoryBookId String?
  memoryBook   MemoryBook?                            @relation(fields: [memoryBookId], references: [id], onDelete: SetNull)
  kind         String // image | video
  status       MediaStatus                            @default(processing)
  s3KeyRaw     String                                 @unique
  variants     Json? // [{ label, format, s3Key, width, height, bytes, sha256 }]
  exifStripped Boolean                                @default(false)
  coordinates  Unsupported("geography(Point, 4326)")?
  takenAt      DateTime?
  // V.UX.11 — per-asset narrative + ordering for memory-book story mode.
  caption      String?
  position     Int                                    @default(0)
  createdAt    DateTime                               @default(now())
  updatedAt    DateTime                               @updatedAt

  @@index([ownerId, createdAt])
  @@index([tripId, createdAt])
  @@index([status])
  @@index([memoryBookId, position])
}

model MemoryBook {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  coverS3Key  String?
  theme       String    @default("classic")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assets MediaAsset[]

  @@index([ownerId, createdAt])
}

// ─── 14. Payments ───────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(trialing)
  priceCents           Int
  currency             String             @db.VarChar(3)
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
}

model EscrowHold {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId             String
  agent               Agent       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  amountUsd           Decimal     @db.Decimal(10, 2)
  currency            String      @db.VarChar(3)
  stripePaymentIntent String      @unique
  state               EscrowState @default(held)
  heldAt              DateTime    @default(now())
  releasedAt          DateTime?
  refundedAt          DateTime?

  @@index([userId, state])
  @@index([agentId, state])
}

model Commission {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType String // stay_booking | agent_service
  sourceId   String
  amountUsd  Decimal   @db.Decimal(10, 2)
  currency   String    @db.VarChar(3)
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─── 15. Notifications ──────────────────────────────────────────────────

model NotificationPreference {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  push               Boolean   @default(true)
  email              Boolean   @default(true)
  sms                Boolean   @default(false)
  quietHours         Json? // { start: "22:00", end: "07:00", tz }
  // V.UX.26 — per-category opt-out. Categories are derived from
  // the `templateId` prefix at dispatch time (trip / safety /
  // social / digest / account). Storing them as a string array
  // keeps the schema flexible — new categories don't need a
  // migration. Empty array = all categories on (the default).
  categoriesDisabled String[]  @default([])
  // V.UX.26 — last weekly-digest tick that fired for this user. The
  // scheduler uses this to enforce a "Sunday 8am LOCAL, once per
  // week" cadence without an external cron table. Null = never
  // received one yet.
  lastDigestSentAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// V.UX.26 — Web Push API subscription. One row per browser
// install — endpoint is globally unique (the URL the browser
// vendor minted). p256dh + auth are the public-key + auth-secret
// the encrypt step needs (Web Push spec §3). Hard-deleted when
// the user revokes permission OR the endpoint returns 410.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model NotificationLog {
  id                String                     @id @default(cuid())
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  templateId        String
  status            NotificationDeliveryStatus @default(queued)
  providerMessageId String?
  payload           Json
  errorMessage      String?
  attempts          Int                        @default(0)
  read              Boolean                    @default(false)
  // V.UX.26 — inbox archive. Set when the user swipes-to-archive
  // a row; the inbox lister filters out non-null. Hard-delete is
  // still available via DELETE /notifications/:id.
  archivedAt        DateTime?
  createdAt         DateTime                   @default(now())
  deliveredAt       DateTime?

  @@index([userId, read, createdAt])
  @@index([userId, archivedAt, createdAt])
  @@index([status, createdAt])
}

// ─── 17. Admin & Ops ────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(admin)
  mfaEnabled   Boolean   @default(true)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ModerationItem {
  id           String           @id @default(cuid())
  targetType   String // review | scam_report | media_asset | agent
  targetId     String
  reason       String
  status       ModerationStatus @default(pending)
  actorId      String? // admin who resolved
  actor        User?            @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  decisionNote String?
  createdAt    DateTime         @default(now())
  decidedAt    DateTime?

  @@unique([targetType, targetId])
  @@index([status, createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique // feature.3d.enabled | scraper.booking.enabled | ...
  description String
  enabled     Boolean  @default(false)
  rollout     Json? // { percentage: 10 } | { cohort: "beta" } | etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// V.UX.36 — append-only admin action log. Every admin write
// (ban/unban/verify/dismiss/resolve/delete/archive) writes one row
// here. Read-only by design — there is no "edit audit row" or
// "delete audit row" verb.
//
// targetType is a free-form string ('user' | 'scam_report' | 'sos' |
// 'media' | 'trip') so new admin verbs can land without a schema
// migration. context carries small per-action payload — for ban it
// holds {reason}; for resolve_sos it holds {note}; for verify_scam
// it holds {verified}. Keep it small (< 1 KB).
//
// actorId is FK to User. SetNull on actor deletion: the audit trail
// outlives the actor (the action history is preserved) but the
// actor reference is anonymized, which is the GDPR-friendly semantic
// for admin users who later self-delete via /account/delete. The
// row's `action` + `context` + `targetId` + `createdAt` survive.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetType String // user | scam_report | sos | media | trip | ...
  targetId   String
  action     String // ban | unban | verify_scam | dismiss_scam | resolve_sos | delete_media | delete_trip | archive_trip
  context    Json? // small per-action payload, optional
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ─── 2.0 Agent (Track A) — POST.2A.2 ────────────────────────────────────
//
// Operational tables for the trip agent. Deliberately FK-less on
// `tripId` / `agentRunId` (plain indexed strings, exactly like
// AdminAuditLog.targetId): the agent is an additive operational
// concern, so it never ALTERs the Trip/User tables and an orphan row
// after a trip hard-delete is harmless (the loop just closes it).
// Installed by prompt [POST.2A.2].

enum AgentRunStatus {
  watching
  closed
}

// One supervised agent lifetime over a single trip. Mutable state
// (status flips watching->closed; planVersion bumps on accepted
// re-plans) so it carries createdAt + updatedAt.
model AgentRun {
  id          String         @id @default(cuid())
  tripId      String
  status      AgentRunStatus @default(watching)
  planVersion Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tripId])
  @@index([status, createdAt])
}

// Append-only audit log of everything the agent observed or proposed
// for a run. Read-only by design — there is NO "edit step" or
// "delete step" verb (the repository port exposes append + read
// only). `kind` is free-form so new step types land without a
// migration (same rationale as AdminAuditLog.action). `detail`
// carries a small per-step payload (< 1 KB) — never secrets / PII.
model AgentStep {
  id         String   @id @default(cuid())
  agentRunId String
  kind       String // watch_started | signal_seen | proposal | accepted | declined | watch_closed
  detail     Json? // small per-step payload, optional
  createdAt  DateTime @default(now())

  @@index([agentRunId, createdAt])
  @@index([kind, createdAt])
}

// What an agent run subscribes a trip to. At most one ACTIVE watch
// per trip is a domain invariant enforced by StartTripWatchUseCase
// (not a DB constraint — a trip accumulates closed watches over
// time). Mutable (active flips; thresholds rise on a decline) so it
// carries createdAt + updatedAt.
model TripWatch {
  id                String   @id @default(cuid())
  tripId            String
  agentRunId        String
  subscribedSignals String[] // weather | flight | geofence
  thresholds        Json? // { weather: 0.7, ... } materiality gates
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tripId, active])
  @@index([agentRunId])
}
