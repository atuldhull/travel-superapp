{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS 11 + Fastify modular monolith. Scaffold only — real modules land in [III.11.x] / [IV.18.2.x].",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:demo:reset": "tsx scripts/seed-demo.ts --reset",
    "api:openapi": "ts-node --transpile-only scripts/export-openapi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@app/auth": "workspace:*",
    "@app/config": "workspace:*",
    "@app/errors": "workspace:*",
    "@app/events": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/observability": "workspace:*",
    "@aws-sdk/client-s3": "^3.705.0",
    "@aws-sdk/s3-request-presigner": "^3.705.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "5.22.0",
    "fastify": "^5.2.0",
    "ioredis": "5.10.1",
    "jose": "^5.9.6",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "speakeasy": "2.0.0",
    "web-push": "^3.6.7",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.0.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/speakeasy": "2.0.10",
    "@types/web-push": "^3.6.0",
    "jest": "^29.7.0",
    "prisma": "5.22.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
