{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS 11 + Fastify modular monolith. Scaffold only — real modules land in [III.11.x] / [IV.18.2.x].",
  "main": "./dist/src/main.js",
  "scripts": {
    "dev": "node --watch --require ts-node/register src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "cycles": "node scripts/check-cycles.cjs",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:unit": "jest --config jest.config.unit.cjs",
    "cover:unit": "jest --config jest.config.unit.cjs",
    "mutate": "stryker run",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:demo:reset": "tsx scripts/seed-demo.ts --reset",
    "api:openapi": "ts-node --transpile-only scripts/export-openapi.ts",
    "vapid:generate": "tsx scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@app/auth": "workspace:*",
    "@app/clock": "workspace:*",
    "@app/config": "workspace:*",
    "@app/errors": "workspace:*",
    "@app/events": "workspace:*",
    "@app/jobs": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/observability": "workspace:*",
    "@app/resilience": "workspace:*",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "5.22.0",
    "@sentry/nestjs": "10.57.0",
    "fastify": "^5.2.0",
    "ioredis": "5.11.1",
    "jose": "^5.9.6",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "resend": "6.12.4",
    "rxjs": "^7.8.1",
    "sharp": "0.35.1",
    "speakeasy": "2.0.0",
    "stripe": "22.2.1",
    "twilio": "6.0.2",
    "web-push": "^3.6.7",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.1.27",
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/jest-runner": "^9.2.0",
    "@stryker-mutator/typescript-checker": "^9.2.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/speakeasy": "2.0.10",
    "@types/web-push": "^3.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "17.4.3",
    "fast-check": "^3.23.0",
    "jest": "^29.7.0",
    "jest-junit": "17.0.0",
    "madge": "^8.0.0",
    "prisma": "5.22.0",
    "rimraf": "^6.0.1",
    "testcontainers": "^10.16.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
