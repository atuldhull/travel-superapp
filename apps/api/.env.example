# TravelSuperApp api — env.example
#
# Copy to apps/api/.env.local and fill in. Values commented `optional`
# can stay blank — the matching feature is silently swapped for its
# stub equivalent and the app boots clean.
#
# Required vars are grouped at the top; everything below is optional.
# Generated for POST.3 — last bumped when Resend + Google were wired.

# ─── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database (Postgres 16 + PostGIS + pgvector) ─────────────────────
DATABASE_URL=postgresql://travel:travel_dev@127.0.0.1:5432/travel_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis 7 ──────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_dev@127.0.0.1:6379

# ─── JWT (REQUIRED — generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
JWT_ACCESS_SECRET=REPLACE_ME_SEE_DOPPLER
JWT_REFRESH_SECRET=REPLACE_ME_SEE_DOPPLER
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Email pepper (REQUIRED — same generator as JWT secrets) ─────────
EMAIL_PEPPER=REPLACE_ME_SEE_DOPPLER

# ─── S3 / MinIO ───────────────────────────────────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=travel-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
S3_REGION=us-east-1

# ─── Meilisearch ──────────────────────────────────────────────────────
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=REPLACE_ME_SEE_DOPPLER

# ─── Web base URL (for outbound links in emails) ─────────────────────
WEB_BASE_URL=http://localhost:3002

# ─── POST.3 — Outbound email (optional; stub when blank) ─────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx          # https://resend.com — free 3k/mo
# EMAIL_FROM_NAME=TravelSuperApp                 # default: TravelSuperApp
# EMAIL_FROM_ADDRESS=hello@yourdomain.com        # MUST be a Resend-verified domain
RESEND_API_KEY=
EMAIL_FROM_NAME=TravelSuperApp
EMAIL_FROM_ADDRESS=no-reply@travel.local

# ─── Google OAuth (optional; "Sign in with Google" hidden when blank) ───
# This uses Google Identity Services (the browser gets an id_token which the
# API verifies via Google's JWKS) — NO server redirect/callback URI needed.
#   1. https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create credentials → OAuth client ID → Application type: "Web application"
#   3. Authorized JavaScript origins: http://localhost:3002 AND http://127.0.0.1:3002
#      (leave "Authorized redirect URIs" empty — this flow doesn't use them)
#   4. Paste the SAME Client ID into GOOGLE_CLIENT_ID below (here) AND into
#      NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web/.env.local. The API uses it as the
#      token audience; GOOGLE_CLIENT_SECRET is NOT needed for this flow.
#   In prod/staging put the value in Doppler, not in a committed file (REPLACE_ME_SEE_DOPPLER).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=           # unused by the current GIS flow; reserved for a future code-exchange flow

# ─── Apple OAuth (optional; not yet wired on web) ────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── POST.4 — AI / LLM (4-tier fallback chain, all optional) ─────────
# Provider priority at boot: Anthropic → Gemini → Ollama → built-in stub.
# Set ANY ONE to activate that tier; leave them all blank for the
# deterministic stub (works offline, no setup, predictable test output).
#
# Tier 1 — Anthropic Claude (paid premium). console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
#
# Tier 2 — Google Gemini Flash (free tier 1500 req/day, no credit card).
# Get a key at https://aistudio.google.com → "Get API key".
# GEMINI_API_KEY=AIzaxxxxx
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# Tier 3 — Ollama (local LLM, truly $0). One-time setup:
#   1. Install: https://ollama.com (Mac/Win/Linux installer)
#   2. Pull a model: `ollama pull llama3.1:8b` (~4.7 GB)
#   3. Start server: `ollama serve` (or run the desktop app)
# OLLAMA_URL=http://localhost:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b

# ─── POST.7 — Twilio SMS for SOS fan-out (optional; stub when blank) ─
# Twilio is paid (no free tier), BUT they offer free TEST credentials
# that simulate success without sending real SMS — perfect for dev/CI.
# Get TEST credentials at https://console.twilio.com → "Settings →
# General → API Credentials → Test credentials". Test SID starts with
# AC… (same format as live) and the SID/token combination only accepts
# specific magic numbers (e.g. +15005550006 for "valid mobile") — no
# real charges. Swap to LIVE credentials for production SMS.
#
# All 3 vars must be set together (partial config = factory falls back
# to the in-memory stub — same as today).
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_FROM_NUMBER=+15005550006   (test) or your purchased number (live)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cost guard: TwilioContactNotifierAdapter caps deliveries at 50 SMS
# per day per api instance. Exceeded → logged + dropped (no thrown
# error so the other contacts in the fan-out still get notified).
# Tunable via DAILY_SMS_CAP constant in the adapter once Redis-backed.

# ─── POST.7 — Web Push (VAPID; optional, no-op when blank, free) ─────
# VAPID keys are self-generated — no service signup, no fee. Generate:
#   pnpm --filter=api vapid:generate
# Then paste the printed VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY here.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY (printed alongside) goes into apps/web/.env
# so the service worker can subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@travel.local

# ─── POST.9 — Stripe Premium checkout (optional; 503s when blank) ────
# TEST mode is FREE forever for development. Get keys at
# https://dashboard.stripe.com (no card required). All 3 vars must be
# set together — partial config throws at api boot.
#
# 1. STRIPE_SECRET_KEY: sk_test_… for dev, sk_live_… for production
# 2. STRIPE_WEBHOOK_SECRET: whsec_… (from `stripe listen` in dev or the
#    Stripe Dashboard webhook endpoint config in prod)
# 3. STRIPE_PRICE_PREMIUM: price_… (a recurring $9/mo USD price you
#    create once in the Stripe Dashboard → Products)
#
# Local dev webhook setup (one-time):
#   stripe listen --forward-to http://localhost:3000/api/v1/payments/webhook
#   → copy the whsec_… it prints into STRIPE_WEBHOOK_SECRET below
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# STRIPE_PRICE_PREMIUM=price_xxxxx
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=

# ─── POST.10 — Observability (Sentry + Honeycomb; all optional) ──────
# All keys are FREE-tier eligible. Activation pattern matches the
# rest of the codebase: missing key = no-op.
#
# Sentry (free 5k errors/mo + 100 perf/min, no card):
#   1. Sign up at https://sentry.io
#   2. Create a project → "Node.js (NestJS)" → copy the DSN
# SENTRY_DSN_API=https://xxx@o000000.ingest.sentry.io/0000000
SENTRY_DSN_API=
#
# Honeycomb (free 20M events/mo, no card):
#   1. Sign up at https://ui.honeycomb.io
#   2. Account → Environments & API Keys → copy a non-restricted key
# HONEYCOMB_API_KEY=hcaik_xxxxx
# HONEYCOMB_DATASET=api-development   (defaults to ${serviceName}-${NODE_ENV})
HONEYCOMB_API_KEY=
HONEYCOMB_DATASET=
#
# Legacy single Sentry DSN (some older code reads SENTRY_DSN as
# a fallback for SENTRY_DSN_API). Leave blank and use the typed
# vars above instead.
SENTRY_DSN=
#
# Local Jaeger trace UI (when running infra/docker-compose with the
# jaeger service). Overridden by HONEYCOMB_API_KEY when that's set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_DISABLED=true to skip tracing entirely (useful for unit-test
# runs to keep the exporter retry log out of test output).
