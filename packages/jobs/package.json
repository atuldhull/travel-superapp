{
  "name": "@app/jobs",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ wrapper — typed Queue + Worker factories, cluster-safe hash-tagged prefix, OnModuleDestroy + Worker.close() invariants enforced. Producer side in apps/api; consumer side in apps/notification-worker / apps/media-service / apps/crawler-worker.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bullmq": "^5.78.0",
    "ioredis": "^5.11.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@nestjs/common": "^11.1.24",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.2"
  }
}
