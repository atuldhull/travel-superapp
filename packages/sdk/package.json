{
  "name": "@app/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Auto-generated typed clients (React Query + plain fetch) for the TravelSuperApp API. Generated from docs/api/openapi.yaml via orval.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist src/generated",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "sdk:gen": "orval --config orval.config.ts"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "orval": "^7.3.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
