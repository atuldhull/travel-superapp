{
  "name": "@app/clock",
  "version": "0.0.0",
  "private": true,
  "description": "Injectable Clock service — SystemClock (prod), FakeClock (tests). Lifts every `new Date()` / `Date.now()` off the global so time-driven tests stop depending on the wall clock.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.1",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
