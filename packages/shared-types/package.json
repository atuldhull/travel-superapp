{
  "name": "@app/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas + inferred TS types shared across backend and frontends.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "schemas:emit": "tsx scripts/emit-json-schemas.mjs",
    "pydantic:emit": "node scripts/emit-pydantic.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
