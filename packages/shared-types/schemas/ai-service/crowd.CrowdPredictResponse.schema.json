{
  "$ref": "#/definitions/CrowdPredictResponse",
  "definitions": {
    "CrowdPredictResponse": {
      "type": "object",
      "properties": {
        "density": {
          "type": "string",
          "enum": [
            "empty",
            "light",
            "busy",
            "packed"
          ]
        },
        "densityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "features": {
          "type": "object",
          "properties": {
            "dayOfWeek": {
              "type": "number"
            },
            "hourOfDay": {
              "type": "number"
            },
            "isHoliday": {
              "type": "boolean"
            }
          },
          "required": [
            "dayOfWeek",
            "hourOfDay",
            "isHoliday"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "density",
        "densityScore",
        "confidence",
        "features"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
