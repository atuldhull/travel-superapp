            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "label": {
                "type": "string",
                "enum": [
                  "real",
                  "suspicious",
                  "fake"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 4
              }
            },
            "required": [
              "id",
              "score",
              "label",
              "reasons"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "results"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
