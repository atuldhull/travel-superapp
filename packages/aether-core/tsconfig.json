{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig/nestjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022"
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["dist", "node_modules"]
}
