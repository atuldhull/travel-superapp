{
  "name": "@app/aether-core",
  "version": "0.0.0",
  "private": true,
  "description": "Aether runtime — composite provider (theme + audio + perception + premium + reduced-motion) + Phase 1 Surface manager (registry + lifecycle FSM + route → 3D scene mapping). Audio engine lazy-loads Tone.js so non-audio surfaces keep a thin bundle.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./audio-engine": {
      "types": "./src/audio-engine.ts",
      "default": "./src/audio-engine.ts"
    },
    "./surface": {
      "types": "./src/surface/index.ts",
      "default": "./src/surface/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@app/aether-motion": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "tone": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "tone": {
      "optional": true
    }
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.2"
  }
}
