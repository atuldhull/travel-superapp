{
  "name": "@app/aether-motion",
  "version": "0.0.0",
  "private": true,
  "description": "Aether design-DNA tokens — Warm Italian tactile palette, spring physics, typography, audio key signatures. Pure values, no React. Every Aether package consumes this; nothing else consumes anything else.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./color": {
      "types": "./src/color.ts",
      "default": "./src/color.ts"
    },
    "./spring": {
      "types": "./src/spring.ts",
      "default": "./src/spring.ts"
    },
    "./type": {
      "types": "./src/type.ts",
      "default": "./src/type.ts"
    },
    "./audio": {
      "types": "./src/audio.ts",
      "default": "./src/audio.ts"
    },
    "./scale": {
      "types": "./src/scale.ts",
      "default": "./src/scale.ts"
    },
    "./easing": {
      "types": "./src/easing.ts",
      "default": "./src/easing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
