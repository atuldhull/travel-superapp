{
  "name": "@app/aether-motion",
  "version": "0.0.0",
  "private": true,
  "description": "Aether design-DNA tokens — Warm Italian tactile palette, spring physics, typography, audio key signatures. Pure values, no React. Every Aether package consumes this; nothing else consumes anything else.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "default": "./dist/color.js"
    },
    "./spring": {
      "types": "./dist/spring.d.ts",
      "default": "./dist/spring.js"
    },
    "./type": {
      "types": "./dist/type.d.ts",
      "default": "./dist/type.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "default": "./dist/audio.js"
    },
    "./scale": {
      "types": "./dist/scale.d.ts",
      "default": "./dist/scale.js"
    },
    "./easing": {
      "types": "./dist/easing.d.ts",
      "default": "./dist/easing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
