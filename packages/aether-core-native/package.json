{
  "name": "@app/aether-core-native",
  "version": "0.0.0",
  "private": true,
  "description": "Aether 2.0 core for React Native. Re-exports the entire surface manager + palette API from @app/aether-core (the pure pieces work on native unchanged) and adds a React-Context-only palette slots provider that replaces the web's CSS custom properties (which RN has no equivalent for). Phase 4 native foundation, AE514.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@app/aether-canvas-shared": "workspace:*",
    "@app/aether-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.16",
    "jest": "^29.7.0",
    "react": "^19.2.7",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.2"
  }
}
